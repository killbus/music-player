# Configure before enabling music-player.service.
# The default output is CPAL; a system service needs access to its output device.
# For FIFO, see dist/README.md for a systemd permission drop-in.
# MUSIC_PLAYER_AUDIO_OUTPUT=fifo:/tmp/snapfifo
# MUSIC_PLAYER_MUSIC_DIRECTORY=/srv/music
# HTTP ports below 1024 are supported by the service's CAP_NET_BIND_SERVICE.
# MUSIC_PLAYER_HTTP_PORT=80
