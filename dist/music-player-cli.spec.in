%global debug_package %{nil}
# Preserve the exact canonical binary used by archives and DEB/OCI.
%global __os_install_post %{nil}
Name:           music-player-cli
Version:        @VERSION@
Release:        1
Summary:        Music player daemon, terminal client and embedded Web UI
License:        MIT
URL:            https://github.com/tsirysndr/music-player
BuildArch:      @RPM_ARCH@
Conflicts:      music-player
Requires:       ca-certificates
# ELF shared-library requirements are generated by rpmbuild.

%description
Headless distribution without the Slint desktop application.

%prep
%build
%install
cp -a %{_sourcedir}/root/. %{buildroot}/

%files
%license /usr/share/licenses/music-player-cli/LICENSE
/usr/bin/music-player
